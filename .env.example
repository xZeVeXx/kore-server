# Kopiere diese Datei nach .env und setze eigene Werte.
# .env ist in .gitignore — trage hier NIE echte Tokens ein.

# Zwei getrennte Bearer-Tokens: App -> Ingest, Agent -> MCP.
# Erzeugen mit: openssl rand -hex 24
# Ingest und MCP starten nicht, solange ein Token oder das Origin-Geheimnis leer
# ist oder noch mit "change-me" beginnt.
KORE_INGEST_TOKEN=change-me-app-token
KORE_MCP_TOKEN=change-me-agent-token

# Wer darf den MCP-Token benutzen (freier, stabiler Name; erscheint in Logs).
KORE_MCP_CLIENT_ID=my-hermes

# Gemeinsames Geheimnis zwischen Coach-Bridge und MCP-Server. Nur damit kann
# ein Plan-Vorschlag geschrieben werden (Origin-Ticket, HMAC, einmalig, kurzlebig).
# Mindestens 32 Bytes: openssl rand -hex 32
KORE_PLAN_ORIGIN_SECRET=change-me-origin-secret-at-least-32-bytes-long

# Identität dieser Installation. Beide Werte müssen in Server UND Bridge gleich
# sein; der Store bindet die Datenbank beim ersten Start daran.
KORE_INSTANCE_ID=kore
KORE_PLAN_ORIGIN_PRINCIPAL=kore

# Pfad der SQLite-Datei. Unter Docker Compose kommt der Wert aus der Compose-Datei
# (/data/kore.db im Volume) und ueberschreibt diese Zeile.
KORE_DB_PATH=/data/kore.db

# Adresse, auf der die beiden Ports veroeffentlicht werden (Docker Compose) bzw.
# auf der der Ingest lauscht (systemd, deploy/kore-ingest.service). Default: nur lokal.
# Fuer das iPhone im eigenen LAN die LAN-IP dieses Rechners eintragen,
# z. B. KORE_BIND_ADDRESS=10.0.0.10 — nie 0.0.0.0, nie ins Internet.
# (Im Container selbst lauschen die Dienste auf 0.0.0.0; nach aussen veroeffentlicht
# Compose sie nur auf dieser Adresse.)
KORE_BIND_ADDRESS=127.0.0.1

# Zustandsordner der Geraete-Kopplung auf dem Host (contract/pairing-v1.md). Er gehoert dem Nutzer
# der Coach-Bridge (Ordner 0750, devices.json 0640, der Rest 0600); Docker Compose bindet ihn nur
# lesend als /state in den Ingest ein. Standard ./state neben docker-compose.yml. Ohne Docker
# (systemd) den absoluten Pfad eintragen, den auch die Bridge benutzt.
# VOR dem ersten `docker compose up` anlegen — sonst legt Docker ihn als root an:
#   scripts/kore-doctor init-state      (als Nutzer der Bridge; gibt die gid fuer die Zeile unten aus)
# KORE_STATE_DIR=./state

# Gruppe des Bridge-Nutzers (id -g). Der Ingest-Container tritt ihr per group_add bei und liest so
# devices.json (nur SHA-256-Hashes), ohne dass die Datenbank oder die Dateien umziehen muessen.
# Pflicht fuer Docker Compose: ohne diese Zeile startet `docker compose up` nicht.
KORE_STATE_GID=

# Browser-Herkuenfte, die Ingest und MCP annehmen duerfen (Komma-getrennt, exakt
# mit Schema und Port). LEER LASSEN: dann kommt ueberhaupt keine Anfrage mit
# Origin-Header durch — nur Clients ohne Origin, also App, Agent und curl.
# Das ist der Schutz gegen DNS-Rebinding: sonst koennte eine beliebige offene
# Webseite deinen lokalen Server ansprechen. Nur fuellen, wenn du wirklich eine
# eigene Weboberflaeche davor haengst, z. B.
# KORE_MCP_ALLOWED_ORIGINS=http://localhost:5173
KORE_MCP_ALLOWED_ORIGINS=

# Optional:
# KORE_PLAN_ORIGIN_MAX_TTL_SECONDS=300
# KORE_PLAN_ORIGIN_CLOCK_SKEW_SECONDS=5
# Nur fuer eine einmalige, bewusste Migration einer Datenbank ohne Eigentuemer:
# KORE_LEGACY_DB_OWNER_CONFIRMATION=<KORE_INSTANCE_ID>:<KORE_PLAN_ORIGIN_PRINCIPAL>
