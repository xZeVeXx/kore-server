# Kopiere nach bridge.env (gitignored) und setze eigene Werte.
# Die Bridge laeuft auf dem Rechner, auf dem auch Hermes laeuft.

# Bearer-Token, das die Kore-App gegenueber der Bridge vorzeigt (zugleich Schluessel der
# Session-Signaturen). Erzeugen mit: openssl rand -hex 24
# Die Bridge startet nicht, solange das Token oder das Origin-Geheimnis leer ist,
# noch mit "change-me" beginnt oder das Token kuerzer als 32 Zeichen ist.
KORE_BRIDGE_TOKEN=change-me-bridge-token

# Nur Loopback, eine konkrete RFC-1918-Adresse oder eine VPN-Adresse (100.64.0.0/10, z. B. Tailscale);
# 0.0.0.0, Hostnamen und oeffentliche Adressen werden abgelehnt.
KORE_BRIDGE_BIND_HOST=127.0.0.1
KORE_BRIDGE_PORT=8090

# Hermes: Binary, Home-Verzeichnis und Profil, das den kore-MCP eingetragen hat.
# <HERMES_HOME> = Home des Nutzers, unter dem Hermes laeuft. `hermes` liegt meist
# nicht im PATH; die Standardinstallation legt es unter ~/.hermes/hermes-agent/venv/bin/ ab.
# Profil: das Trainings-Bot-Profil, mit dem Kore spricht (Vorschlag kore-coach,
# jeder gueltige Hermes-Profilname geht).
KORE_HERMES_BIN=<HERMES_HOME>/.hermes/hermes-agent/venv/bin/hermes
KORE_HERMES_HOME=<HERMES_HOME>
KORE_HERMES_PROFILE=kore-coach

# Optional: Datenordner von Hermes, wenn er NICHT unter <HERMES_HOME>/.hermes liegt, z. B. im
# Hermes-Docker-Image (HERMES_HOME=/opt/data). Absoluter Pfad ohne `..`; sonst startet die Bridge nicht.
# Die Bridge gibt ihn als HERMES_HOME an Hermes weiter (das ist die einzige Zugabe zur Kind-Umgebung
# aus HOME, PATH und den TLS-/Locale-Schluesseln) und sucht das Profil unter <Ordner>/profiles/<Profil>
# bzw. <Ordner>/config.yaml fuer das Profil `default`. kore-doctor liest dieselbe Zeile.
# Unter systemd den Ordner zusaetzlich in ReadWritePaths der Unit eintragen.
# KORE_HERMES_DATA_DIR=/opt/data

# Optional: Basis der Arbeitsordner der Hermes-Laeufe. Standard: <Hermes-Datenordner>/kore-bridge-work; die
# Bridge nutzt darin `chat` und leert ihn vor und nach jedem Lauf. Nur setzen, wenn das Gateway von Hermes
# diesen Ordner nicht sieht. Nie in einem Git-Checkout; unter systemd in ReadWritePaths der Unit eintragen.
# KORE_HERMES_WORK_DIR=/srv/kore-work

# Identitaet dieser Installation — muss exakt den Werten des Servers entsprechen.
KORE_INSTANCE_ID=kore
KORE_PLAN_ORIGIN_PRINCIPAL=kore

# Pflicht: dasselbe Geheimnis wie KORE_PLAN_ORIGIN_SECRET des MCP-Servers (und oben
# derselbe KORE_PLAN_ORIGIN_PRINCIPAL). Ohne beide startet die Bridge nicht.
KORE_PLAN_ORIGIN_SECRET=change-me-origin-secret-at-least-32-bytes-long

# NICHT setzen. Die Bridge reicht den Prompt nur ueber stdin weiter
# (`hermes chat --query-file -`); er steht weder in der Prozessliste noch auf der
# Platte. Mit =1 lehnt die Bridge seit 0.10 jeden Coach-Aufruf ab (503) und warnt
# beim Start — den frueheren argv-Weg gibt es nicht mehr.
# KORE_HERMES_ALLOW_ARGV_PROMPTS=1

# Geraete-Kopplung (contract/pairing-v1.md): Zustandsordner, den der Ingest nur lesend mitbenutzt
# (docker-compose.yml bindet ${KORE_STATE_DIR:-./state} als /state ein). Standard: state/ im
# Repo-Wurzelverzeichnis. Laeuft die Bridge aus einer Kopie ausserhalb des Repos, hier und in der
# Server-.env denselben absoluten Pfad eintragen; pairing.py gehoert neben bridge.py. Fehlt der
# Ordner oder ist er nicht beschreibbar, startet die Bridge trotzdem, meldet das im Journal und
# beantwortet POST /pair mit 401.
# KORE_STATE_DIR=/srv/kore-server/state

# Optionale Grenzen (Defaults in Klammern):
# KORE_BRIDGE_TIMEOUT=150                  # Sekunden (150)
# KORE_BRIDGE_MAX_REQUEST_BYTES=262144     # (256 KiB)
# KORE_HERMES_MAX_OUTPUT_BYTES=524288      # (512 KiB)
# KORE_HERMES_MAX_PROMPT_BYTES=122880      # (120 KiB)
# KORE_PLAN_ORIGIN_TTL_SECONDS=180         # (180)
# KORE_BRIDGE_SESSION_RETENTION_DAYS=30    # Kore-Sessions verfallen nach N Tagen ohne Aktivitaet (30, hoechstens 30)
# PATH fuer Hermes. Ersetzt den Standard /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# (nichts wird angehaengt), die Systemordner muessen also mit in die Liste. Braucht der Modell-Anbieter
# ein Programm ausserhalb davon (z. B. `claude` in ~/.local/bin), dessen Ordner vorn eintragen; ohne
# das scheitert der Chat mit hermes_failed. Absolute Pfade, systemd expandiert kein ~. scripts/kore-doctor
# prueft das:
# KORE_HERMES_CHILD_PATH=/home/<nutzer>/.local/bin:/usr/local/bin:/usr/bin:/bin

# Anzeigename des Coaches in der App (optional). 1-24 Zeichen: Buchstaben, Ziffern, Leerzeichen,
# Bindestrich, Apostroph, Punkt; sonst wird der Wert ignoriert (eine Warnung im Journal, die Bridge
# startet trotzdem). Erscheint als "coach_name" in /health und /capabilities, nur wenn gueltig.
# KORE_COACH_NAME=Coach Lena
