# Kopiere nach bridge.env (gitignored) und setze eigene Werte.
# Die Bridge laeuft auf dem Rechner, auf dem auch Hermes laeuft.

# Bearer-Token, das die Kore-App gegenueber der Bridge vorzeigt.
# Erzeugen mit: openssl rand -hex 24
KORE_BRIDGE_TOKEN=change-me-bridge-token

# Nur Loopback oder eine konkrete RFC-1918-Adresse; 0.0.0.0 wird abgelehnt.
KORE_BRIDGE_BIND_HOST=127.0.0.1
KORE_BRIDGE_PORT=8090

# Hermes: Binary, Home-Verzeichnis und Profil, das den kore-MCP eingetragen hat.
KORE_HERMES_BIN=/home/hermes/.hermes/hermes-agent/venv/bin/hermes
KORE_HERMES_HOME=/home/hermes
KORE_HERMES_PROFILE=<profil>

# Identitaet dieser Installation — muss exakt den Werten des Servers entsprechen.
KORE_INSTANCE_ID=kore
KORE_PLAN_ORIGIN_PRINCIPAL=kore

# Dasselbe Geheimnis wie KORE_PLAN_ORIGIN_SECRET des MCP-Servers. Ohne diesen
# Wert kann die Bridge keine Plan-Vorschlaege ausloesen (Lesen geht trotzdem).
KORE_PLAN_ORIGIN_SECRET=change-me-origin-secret-at-least-32-bytes-long

# Pflicht (die Bridge startet sonst nicht): die hermes-CLI hat keinen geprueften
# Prompt-Weg ausser argv. Das heisst, der komplette Prompt steht waehrend des
# Aufrufs in der Prozessliste und ist fuer jeden lokalen Nutzer dieses Rechners
# lesbar. Betreibe die Bridge nur auf einem Rechner, dem du allein vertraust.
KORE_HERMES_ALLOW_ARGV_PROMPTS=1

# Optionale Grenzen (Defaults in Klammern):
# KORE_BRIDGE_TIMEOUT=150                  # Sekunden (150)
# KORE_BRIDGE_MAX_REQUEST_BYTES=262144     # (256 KiB)
# KORE_HERMES_MAX_OUTPUT_BYTES=524288      # (512 KiB)
# KORE_HERMES_MAX_PROMPT_BYTES=122880      # (120 KiB)
# KORE_PLAN_ORIGIN_TTL_SECONDS=180         # (180)
# KORE_HERMES_CHILD_PATH=/usr/local/bin:/usr/bin:/bin
